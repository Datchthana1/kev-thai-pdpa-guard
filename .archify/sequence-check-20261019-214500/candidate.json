    { "id": "tax", "type": "security", "label": "taxonomy.py", "sublabel": "PDPA questions" },
    { "id": "system", "type": "backend", "label": "KevSystem", "sublabel": "systems.py" },
    { "id": "api", "type": "backend", "label": "kev.api", "sublabel": "to_record()" },
    { "id": "model", "type": "backend", "label": "Qwen3.5-4B NF4", "sublabel": "+ LoRA adapter" },
    { "id": "head", "type": "database", "label": "Pointer head", "sublabel": "head.pt, T" }
  ],
  "segments": [
    { "from": 150, "to": 236, "label": "Build questions" },
    { "from": 242, "to": 512, "label": "Score on GPU, one prefill" },
    { "from": 518, "to": 600, "label": "Result" }
  ],
  "messages": [
    { "id": "call-check", "from": "app", "to": "guard", "y": 165, "label": "check(text)", "variant": "emphasis" },
