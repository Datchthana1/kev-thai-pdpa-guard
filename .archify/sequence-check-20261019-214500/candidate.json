    { "participant": "head", "from": 420, "to": 459, "type": "database" }
  ],
  "cards": [
    { "dot": "violet", "title": "Input", "items": ["A Thai or English string, or a JSON object/array", "Questions are fixed: is_sensitive, risk_level, primary_category, 8 has_* flags"] },
    { "dot": "emerald", "title": "Output", "items": ["p_sensitive and is_sensitive at threshold 0.5", "risk_level 0-4 plus expected risk_score", "primary_category with probabilities, 8 flag probabilities"] },
