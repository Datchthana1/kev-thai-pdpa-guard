  ],
  "cards": [
    { "dot": "emerald", "title": "Labels from code", "items": ["Every record keeps its PII spans", "taxonomy.py turns spans into 11 labels", "No writer ever chooses a label"] },
    { "dot": "rose", "title": "Fake but valid", "items": ["National IDs pass the mod-11 checksum", "Card numbers pass Luhn with real prefixes", "Look-alikes that fail them are hard negatives"] },
    { "dot": "amber", "title": "No leakage", "items": ["Test uses B templates by other authors", "0 near-duplicates across splits", "sha256 of each file in FROZEN.sha256"] }
